package com.campusqueue.app;

import android.Manifest;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.content.pm.PackageManager;
import android.database.Cursor;
import android.os.Build;
import android.os.Bundle;
import android.os.Handler;
import android.view.LayoutInflater;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.ProgressBar;
import android.widget.TextView;
import androidx.appcompat.app.AppCompatActivity;
import androidx.core.app.ActivityCompat;
import androidx.core.app.NotificationCompat;
import androidx.core.app.NotificationManagerCompat;
import androidx.core.content.ContextCompat;
import com.google.android.material.appbar.MaterialToolbar;
import com.google.firebase.database.DataSnapshot;
import com.google.firebase.database.DatabaseError;
import com.google.firebase.database.DatabaseReference;
import com.google.firebase.database.FirebaseDatabase;
import com.google.firebase.database.ValueEventListener;
import java.util.ArrayList;
import java.util.List;

public class QueueStatusActivity extends AppCompatActivity {

    private LinearLayout ticketContainer;
    private ProgressBar progressBar;
    private MaterialToolbar topAppBar;

    private SharedPreferences prefs;
    private DatabaseHelper dbHelper;
    private Handler queueHandler = new Handler();
    private String currentUser;

    private static final String CHANNEL_ID = "campus_queue_notifications";

    private class TicketModel {
        int id;
        String department;
        String prefix;
        int tokenNum;
        int currentServing;
    }
    private List<TicketModel> activeTickets = new ArrayList<>();

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_queue_status);

        createNotificationChannel();
        requestNotificationPermission();

        dbHelper = new DatabaseHelper(this);
        ticketContainer = findViewById(R.id.ticketContainer);
        progressBar = findViewById(R.id.progressBar);
        topAppBar = findViewById(R.id.topAppBar);

        topAppBar.setNavigationOnClickListener(v -> finish());
        
        prefs = getSharedPreferences("QueueAppPrefs", MODE_PRIVATE);
        currentUser = prefs.getString("current_user", "guest");

        fetchQueueStatus();
    }

    private void requestNotificationPermission() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            if (ContextCompat.checkSelfPermission(this, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
                ActivityCompat.requestPermissions(this, new String[]{Manifest.permission.POST_NOTIFICATIONS}, 101);
            }
        }
    }

    private void createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            CharSequence name = "Queue Turn Notification";
            String description = "Notifies when it is your turn in the queue";
            int importance = NotificationManager.IMPORTANCE_HIGH;
            NotificationChannel channel = new NotificationChannel(CHANNEL_ID, name, importance);
            channel.setDescription(description);

            NotificationManager notificationManager = getSystemService(NotificationManager.class);
            if (notificationManager != null) {
                notificationManager.createNotificationChannel(channel);
            }
        }
    }

    private void sendTurnNotification(String department, String token) {
        Intent intent = new Intent(this, MainActivity.class);
        intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
        PendingIntent pendingIntent = PendingIntent.getActivity(this, 0, intent, PendingIntent.FLAG_IMMUTABLE);

        NotificationCompat.Builder builder = new NotificationCompat.Builder(this, CHANNEL_ID)
                .setSmallIcon(android.R.drawable.ic_dialog_info)
                .setContentTitle("It's your turn! (" + token + ")")
                .setContentText("Please proceed to the " + department + " counter.")
                .setPriority(NotificationCompat.PRIORITY_HIGH)
                .setContentIntent(pendingIntent)
                .setAutoCancel(true);

        NotificationManagerCompat notificationManager = NotificationManagerCompat.from(this);
        if (ActivityCompat.checkSelfPermission(this, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED) {
            notificationManager.notify((int) System.currentTimeMillis(), builder.build());
        }
    }

    private void fetchQueueStatus() {
        progressBar.setVisibility(View.VISIBLE);
        new Handler().postDelayed(() -> {
            progressBar.setVisibility(View.GONE);
            loadActiveTicketsFromDb();
        }, 500);
    }

    private void loadActiveTicketsFromDb() {
        activeTickets.clear();
        Cursor cursor = dbHelper.getTicketsByStatus(currentUser, "active");
        if (cursor.moveToFirst()) {
            do {
                TicketModel tm = new TicketModel();
                tm.id = cursor.getInt(cursor.getColumnIndexOrThrow(DatabaseHelper.COL_ID));
                tm.department = cursor.getString(cursor.getColumnIndexOrThrow(DatabaseHelper.COL_DEPARTMENT));
                tm.prefix = cursor.getString(cursor.getColumnIndexOrThrow(DatabaseHelper.COL_PREFIX));
                tm.tokenNum = cursor.getInt(cursor.getColumnIndexOrThrow(DatabaseHelper.COL_TOKEN_NUM));
                tm.currentServing = cursor.getInt(cursor.getColumnIndexOrThrow(DatabaseHelper.COL_CURRENT_SERVING));
                activeTickets.add(tm);
            } while (cursor.moveToNext());
        }
        cursor.close();

        if (activeTickets.isEmpty()) {
            ticketContainer.removeAllViews();
            TextView noTicketsText = new TextView(this);
            noTicketsText.setText("You don't have any active tickets in your queue.");
            noTicketsText.setTextSize(16);
            noTicketsText.setPadding(32, 64, 32, 32);
            ticketContainer.addView(noTicketsText);
            return;
        }

        buildTicketViews();
        startLiveQueueSimulation();
    }

    private void buildTicketViews() {
        ticketContainer.removeAllViews();
        LayoutInflater inflater = LayoutInflater.from(this);

        for (TicketModel ticket : activeTickets) {
            View cardView = inflater.inflate(R.layout.item_ticket_card, ticketContainer, false);
            
            TextView tvDepartmentName = cardView.findViewById(R.id.tvDepartmentName);
            TextView tvTokenNumber = cardView.findViewById(R.id.tvTokenNumber);
            TextView tvCurrentServing = cardView.findViewById(R.id.tvCurrentServing);
            TextView tvServingUser = cardView.findViewById(R.id.tvServingUser);
            TextView tvEstimatedTime = cardView.findViewById(R.id.tvEstimatedTime);
            TextView tvUserEmail = cardView.findViewById(R.id.tvUserEmail);

            tvUserEmail.setText("User: " + currentUser);
            tvDepartmentName.setText(ticket.department);
            tvTokenNumber.setText(ticket.prefix + "-" + ticket.tokenNum);

            String servingEmail = dbHelper.getUserByToken(ticket.department, ticket.currentServing);
            if (servingEmail.equals("Unknown")) {
                tvServingUser.setText("Serving: " + ticket.prefix + "-" + ticket.currentServing);
            } else {
                tvServingUser.setText("Serving: " + servingEmail);
            }

            if (ticket.currentServing >= ticket.tokenNum) {
                tvCurrentServing.setText(ticket.prefix + "-" + ticket.tokenNum);
                tvEstimatedTime.setText("It's your turn!");
                tvCurrentServing.setTextColor(ContextCompat.getColor(this, R.color.primary_dark));
                tvServingUser.setText("Serving: " + currentUser);
            } else {
                tvCurrentServing.setText(ticket.prefix + "-" + ticket.currentServing);
                int peopleAhead = ticket.tokenNum - ticket.currentServing;
                tvEstimatedTime.setText("Estimated Wait: " + (peopleAhead * 3) + " mins");
            }

            ticketContainer.addView(cardView);
        }
    }

    private void startLiveQueueSimulation() {
        DatabaseReference servingRef = FirebaseDatabase.getInstance().getReference("queues/registrar/currentlyServing/tokenNum");
        servingRef.keepSynced(true);
        servingRef.addValueEventListener(new ValueEventListener() {
            @Override
            public void onDataChange(DataSnapshot snapshot) {
                if (snapshot.exists()) {
                    int serverToken = snapshot.getValue(Integer.class);
                    boolean updated = false;
                    for (TicketModel ticket : activeTickets) {
                        if (ticket.currentServing != serverToken) {
                            if (serverToken == ticket.tokenNum) {
                                String tokenFull = ticket.prefix + "-" + ticket.tokenNum;
                                sendTurnNotification(ticket.department, tokenFull);
                                dbHelper.markTicketCompleted(ticket.id);
                            }
                            ticket.currentServing = serverToken;
                            dbHelper.updateTicketServing(ticket.id, serverToken);
                            updated = true;
                        }
                    }
                    if (updated) {
                        buildTicketViews();
                    }
                }
            }
            @Override
            public void onCancelled(DatabaseError error) {}
        });
    }

    @Override
    protected void onDestroy() {
        super.onDestroy();
        queueHandler.removeCallbacksAndMessages(null);
    }
}
