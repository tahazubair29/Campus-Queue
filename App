package com.campusqueue.app;

import android.content.Intent;
import android.content.SharedPreferences;
import android.os.Bundle;
import android.view.View;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.ProgressBar;
import android.widget.Spinner;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;
import com.google.android.material.appbar.MaterialToolbar;
import com.google.firebase.database.DatabaseReference;
import com.google.firebase.database.FirebaseDatabase;
import com.google.firebase.database.MutableData;
import com.google.firebase.database.Transaction;
import com.google.firebase.database.DataSnapshot;
import com.google.firebase.database.DatabaseError;

public class GenerateTokenActivity extends AppCompatActivity {

    private Spinner spinnerService;
    private Button btnGenerateToken;
    private ProgressBar progressBar;
    private MaterialToolbar topAppBar;
    private DatabaseHelper dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_generate_token);

        dbHelper = new DatabaseHelper(this);
        spinnerService = findViewById(R.id.spinnerService);
        btnGenerateToken = findViewById(R.id.btnGenerateToken);
        progressBar = findViewById(R.id.progressBar);
        topAppBar = findViewById(R.id.topAppBar);

        topAppBar.setNavigationOnClickListener(v -> finish());

        String[] services = new String[]{"Registrar Office", "Cafeteria", "Library", "IT Helpdesk"};
        ArrayAdapter<String> adapter = new ArrayAdapter<>(this, android.R.layout.simple_spinner_dropdown_item, services);
        spinnerService.setAdapter(adapter);

        btnGenerateToken.setOnClickListener(v -> generateToken());
    }

    private void generateToken() {
        String selectedService = spinnerService.getSelectedItem().toString();
        btnGenerateToken.setEnabled(false);

        // CHECK IF QUEUE IS OPEN
        DatabaseReference queueRef = FirebaseDatabase.getInstance().getReference("queues/registrar");
        queueRef.child("isQueueOpen").get().addOnCompleteListener(task -> {
            if (task.isSuccessful() && task.getResult().exists()) {
                boolean isOpen = task.getResult().getValue(Boolean.class);
                if (!isOpen) {
                    progressBar.setVisibility(View.GONE);
                    btnGenerateToken.setEnabled(true);
                    Toast.makeText(this, "Sorry, the Admin has CLOSED the queue. Please try again later.", Toast.LENGTH_LONG).show();
                    return;
                }
            }
            proceedWithTokenGeneration(queueRef, selectedService);
        });
    }

    private void proceedWithTokenGeneration(DatabaseReference queueRef, String selectedService) {
        new android.os.Handler().postDelayed(() -> {
            SharedPreferences prefs = getSharedPreferences("QueueAppPrefs", MODE_PRIVATE);
            String currentUser = prefs.getString("current_user", "guest");
            
            // FIREBASE TRANSACTION FOR CONCURRENCY-SAFE TICKETS
            DatabaseReference lastTokenRef = queueRef.child("lastToken");

            lastTokenRef.runTransaction(new Transaction.Handler() {
                @Override
                public Transaction.Result doTransaction(MutableData currentData) {
                    Integer current = currentData.getValue(Integer.class);
                    if (current == null) {
                        currentData.setValue(101);
                    } else {
                        currentData.setValue(current + 1);
                    }
                    return Transaction.success(currentData);
                }

                @Override
                public void onComplete(DatabaseError error, boolean committed, DataSnapshot snapshot) {
                    progressBar.setVisibility(View.GONE);
                    if (committed) {
                        int myNumber = snapshot.getValue(Integer.class);
                        String prefix = "R";
                        String myToken = prefix + "-" + myNumber;

                        // PUSH TO FIREBASE TICKETS
                        queueRef.child("tickets").child(myToken).child("email").setValue(currentUser);
                        queueRef.child("tickets").child(myToken).child("tokenNum").setValue(myNumber);
                        queueRef.child("tickets").child(myToken).child("status").setValue("waiting");

                        // Save to local SQLite
                        dbHelper.insertTicket(currentUser, selectedService, prefix, myNumber, 100);
                        
                        Toast.makeText(GenerateTokenActivity.this, "Token Generated: " + myToken, Toast.LENGTH_SHORT).show();
                        
                        startActivity(new Intent(GenerateTokenActivity.this, QueueStatusActivity.class));
                        finish();
                    } else {
                        btnGenerateToken.setEnabled(true);
                        Toast.makeText(GenerateTokenActivity.this, "Error generating token", Toast.LENGTH_SHORT).show();
                    }
                }
            });
        }, 500);
    }
}
