package com.campusqueue.app;

import android.os.Bundle;
import android.widget.Button;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;
import com.google.android.material.appbar.MaterialToolbar;
import com.google.android.material.materialswitch.MaterialSwitch;
import com.google.firebase.database.DataSnapshot;
import com.google.firebase.database.DatabaseError;
import com.google.firebase.database.DatabaseReference;
import com.google.firebase.database.FirebaseDatabase;
import com.google.firebase.database.ValueEventListener;

public class AdminPortalActivity extends AppCompatActivity {

    private TextView tvCurrentToken, tvTotalWaiting;
    private Button btnCallNext, btnMarkNoShow, btnResetQueue;
    private MaterialSwitch switchQueueControl;
    private DatabaseHelper dbHelper;
    private DatabaseReference queueRef;
    private int currentTokenNum = 100;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_admin_portal);

        dbHelper = new DatabaseHelper(this);
        MaterialToolbar topAppBar = findViewById(R.id.topAppBar);
        topAppBar.setNavigationOnClickListener(v -> finish());

        tvCurrentToken = findViewById(R.id.tvCurrentToken);
        tvTotalWaiting = findViewById(R.id.tvTotalWaiting);
        btnCallNext = findViewById(R.id.btnCallNext);
        btnMarkNoShow = findViewById(R.id.btnMarkNoShow);
        btnResetQueue = findViewById(R.id.btnResetQueue);
        switchQueueControl = findViewById(R.id.switchQueueControl);

        // INITIALIZE FIREBASE
        queueRef = FirebaseDatabase.getInstance().getReference("queues/registrar");

        // SYNC SWITCH STATUS
        queueRef.child("isQueueOpen").addValueEventListener(new ValueEventListener() {
            @Override
            public void onDataChange(DataSnapshot snapshot) {
                if (snapshot.exists()) {
                    boolean isOpen = snapshot.getValue(Boolean.class);
                    switchQueueControl.setChecked(isOpen);
                }
            }
            @Override
            public void onCancelled(DatabaseError error) {}
        });

        switchQueueControl.setOnCheckedChangeListener((buttonView, isChecked) -> {
            queueRef.child("isQueueOpen").setValue(isChecked);
            String status = isChecked ? "Tokens are now OPEN" : "Tokens are now CLOSED";
            Toast.makeText(this, status, Toast.LENGTH_SHORT).show();
        });

        // LISTEN FOR CHANGES
        queueRef.addValueEventListener(new ValueEventListener() {
            @Override
            public void onDataChange(DataSnapshot snapshot) {
                if (snapshot.exists()) {
                    // Current Serving
                    DataSnapshot servingSnap = snapshot.child("currentlyServing");
                    if (servingSnap.exists() && servingSnap.child("tokenNum").getValue() != null) {
                        currentTokenNum = servingSnap.child("tokenNum").getValue(Integer.class);
                        tvCurrentToken.setText("Current: T-" + currentTokenNum);
                    } else {
                        tvCurrentToken.setText("Current: T-100");
                        queueRef.child("currentlyServing/tokenNum").setValue(100);
                        queueRef.child("currentlyServing/name").setValue("Waiting...");
                    }
                    
                    // Total Waiting
                    long totalWaiting = snapshot.child("tickets").getChildrenCount();
                    tvTotalWaiting.setText("Total Waiting: " + totalWaiting);
                } else {
                    tvCurrentToken.setText("Current: T-100");
                    tvTotalWaiting.setText("Total Waiting: 0");
                    queueRef.child("currentlyServing/tokenNum").setValue(100);
                }
            }

            @Override
            public void onCancelled(DatabaseError error) {
                Toast.makeText(AdminPortalActivity.this, "Sync Error: " + error.getMessage(), Toast.LENGTH_LONG).show();
            }
        });

        btnCallNext.setOnClickListener(v -> {
            int nextNum = currentTokenNum + 1;
            
            // UPDATE FIREBASE - Syncs to students instantly
            queueRef.child("currentlyServing").child("tokenNum").setValue(nextNum);
            queueRef.child("currentlyServing").child("name").setValue("Student " + nextNum);
            
            Toast.makeText(this, "Calling Token T-" + nextNum, Toast.LENGTH_SHORT).show();
        });

        btnResetQueue.setOnClickListener(v -> {
            new androidx.appcompat.app.AlertDialog.Builder(this)
                .setTitle("Reset Entire Queue?")
                .setMessage("This will remove ALL current tokens from ALL students. This action cannot be undone.")
                .setPositiveButton("RESET NOW", (dialog, which) -> {
                    queueRef.child("tickets").removeValue();
                    queueRef.child("lastToken").setValue(100);
                    queueRef.child("currentlyServing/tokenNum").setValue(100);
                    queueRef.child("currentlyServing/name").setValue("Waiting...");
                    
                    Toast.makeText(this, "Queue has been reset!", Toast.LENGTH_LONG).show();
                })
                .setNegativeButton("Cancel", null)
                .show();
        });
    }
}
